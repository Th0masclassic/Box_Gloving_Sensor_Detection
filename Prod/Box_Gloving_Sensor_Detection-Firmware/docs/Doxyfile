# Run from the firmware directory:
#   C:\path\to\doxygen.exe docs\Doxyfile

PROJECT_NAME           = "Smart Boxing Glove Firmware"
PROJECT_BRIEF          = "ESP32-C3 GY-85/FSR acquisition and BLE protocol v2"
OUTPUT_DIRECTORY       = docs/generated
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE         = English
OPTIMIZE_OUTPUT_FOR_C   = YES
MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES

INPUT                  = main components/drivers/include components/drivers/src docs
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h *.md
EXCLUDE_PATTERNS       = */build/* */generated/* */supervisor-checkpoint.md
EXCLUDE_SYMBOLS        =

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
SORT_MEMBER_DOCS       = YES
FULL_PATH_NAMES        = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCES_RELATION    = YES
REFERENCED_BY_RELATION = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
QUIET                  = YES
HAVE_DOT               = NO
